{
  "name": "genpet",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A lightweight story-driven Pet framework for Codex Dots and native Codex Pets.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "install:codex": "npm run build:plugin && npm run build && tsx scripts/install.ts",
    "pet:switch": "node plugins/genpet/dist/cli.js switch-pet",
    "package:plugin": "npm run build:plugin && npm run verify:version && tsx scripts/package.ts",
    "verify:fast": "npm run check && npm run format:check && npm test",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:native": "tsx scripts/verify-native-contract.ts",
    "verify:refresh": "tsx scripts/audit-native-refresh.ts",
    "verify:version": "node scripts/verify-release-version.mjs",
    "format": "prettier --write src tests scripts framework/debugger-web",
    "format:check": "prettier --check src tests scripts framework/debugger-web"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "genpet": "dist/cli.js"
  }
}
